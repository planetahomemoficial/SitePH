---
import { getCollection } from "astro:content";

interface Props {
  title: string;
  description?: string;
  jsonLd?: object[];
}
const { title, description = "Planeta Homem — Força, Honra, Propósito", jsonLd = [] } = Astro.props;

const allArticles = await getCollection("articles");
const categorySlugsWithContent = new Set(allArticles.map((a) => a.data.categorySlug));
const hasContent = (slug: string) => categorySlugsWithContent.has(slug);

const siteUrl = "https://planetahomem.com.br";
const logoUrl = `${siteUrl}/img/brand/logo-planeta-homem.png`;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Planeta Homem",
  "url": siteUrl,
  "logo": logoUrl,
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Planeta Homem",
  "url": siteUrl,
};

type NavLink = { label: string; slug: string };
type NavEntry =
  | { type: "link"; label: string; slug: string }
  | { type: "group"; label: string; children: NavLink[] };

const rawNav: NavEntry[] = [
  { type: "link", label: "Saúde Masculina", slug: "saude-masculina" },
  {
    type: "group",
    label: "Estilo Masculino",
    children: [
      { label: "Estilo Masculino", slug: "estilo-masculino" },
      { label: "Esportes", slug: "esportes" },
      { label: "Viagens", slug: "viagens" },
    ],
  },
  { type: "link", label: "Dinheiro & Carreira", slug: "dinheiro-carreira-e-ia" },
  {
    type: "group",
    label: "Família",
    children: [
      { label: "Paternidade & Família", slug: "paternidade-familia" },
      { label: "Casamento & Sexualidade", slug: "casamento-e-sexualidade" },
    ],
  },
  { type: "link", label: "Propósito & Fé", slug: "homem-proposito-e-fe" },
  {
    type: "group",
    label: "Produtos",
    children: [
      { label: "Eletrônicos", slug: "eletronicos" },
      { label: "Celulares", slug: "celulares" },
      { label: "Utilidades", slug: "utilidades" },
      { label: "Acessórios", slug: "acessorios" },
    ],
  },
];

const navEntries = rawNav
  .map((entry) =>
    entry.type === "group"
      ? { ...entry, children: entry.children.filter((c) => hasContent(c.slug)) }
      : entry
  )
  .filter((entry) => (entry.type === "group" ? entry.children.length > 0 : hasContent(entry.slug)));

const canonicalUrl = new URL(Astro.url.pathname, "https://planetahomem.com.br").toString();
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  {jsonLd.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
  <link rel="stylesheet" href="/css/style.css" />
  <script is:inline>
    (function () {
      var t = null;
      try { t = localStorage.getItem("ph-theme"); } catch (e) {}
      document.documentElement.setAttribute("data-theme", t || "light");
    })();
  </script>
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-9CG9DTPQ2R"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag("js", new Date());
    gtag("config", "G-9CG9DTPQ2R");
    gtag("config", "GT-5NRBFP8S");
  </script>
  <script is:inline>
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
    n.push=n;n.loaded=!0;n.version="2.0";n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
    document,"script","https://connect.facebook.net/en_US/fbevents.js");
    fbq("init", "4428929887206774");
    fbq("track", "PageView");
  </script>
  <noscript>
    <img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=4428929887206774&ev=PageView&noscript=1" />
  </noscript>
</head>
<body>

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      <img src="/img/brand/logo-planeta-homem.png" alt="Planeta Homem" />
    </a>
    <nav class="main-nav">
      <ul>
        {navEntries.map((entry) => (
          entry.type === "link" ? (
            <li><a href={`/categoria/${entry.slug}/`}>{entry.label}</a></li>
          ) : (
            <li class="nav-group">
              <button class="nav-group-toggle" aria-expanded="false">
                {entry.label} <span class="nav-caret">▾</span>
              </button>
              <ul class="nav-dropdown">
                {entry.children.map((child) => (
                  <li><a href={`/categoria/${child.slug}/`}>{child.label}</a></li>
                ))}
              </ul>
            </li>
          )
        ))}
      </ul>
    </nav>
    <button class="theme-toggle" aria-label="Alternar tema">🌙</button>
    <button class="nav-toggle" aria-label="Abrir menu">☰</button>
  </div>
</header>

<main>
  <slot />
</main>

<footer class="site-footer">
  <div class="wrap footer-grid">
    <ul class="footer-nav">
      <li><a href="/sobre-nos/">Sobre Nós</a></li>
      <li><a href="/contact/">Contato</a></li>
      <li><a href="/termos-de-uso/">Termos de Uso</a></li>
      <li><a href="/politica-de-privacidade-2/">Política de Privacidade</a></li>
    </ul>
    <p class="footer-copy">© 2026 Planeta Homem. Todos os direitos reservados.</p>
  </div>
</footer>

<div class="badge-test">Layout de teste</div>

<script is:inline src="/js/theme.js"></script>
</body>
</html>
