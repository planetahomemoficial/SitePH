---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const sorted = [...articles].sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return sorted.map((article, i) => ({
    params: { slug: article.id },
    props: {
      article,
      // Lista está da mais nova para a mais antiga:
      // "anterior" = publicado antes (mais antigo, próximo índice)
      // "posterior" = publicado depois (mais novo, índice anterior)
      prevArticle: sorted[i + 1] ?? null,
      nextArticle: i > 0 ? sorted[i - 1] : null,
    },
  }));
}

const { article, prevArticle, nextArticle } = Astro.props;
const { Content } = await render(article);

const dateFormatted = new Intl.DateTimeFormat("pt-BR", {
  day: "2-digit",
  month: "2-digit",
  year: "numeric",
  timeZone: "UTC",
}).format(article.data.date);

const siteUrl = "https://planetahomem.com.br";
const articleUrl = `${siteUrl}/${article.id}/`;
const imageUrl = article.data.image.startsWith("http") ? article.data.image : `${siteUrl}${article.data.image}`;
const isoDate = article.data.date.toISOString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.data.title,
  "description": article.data.excerpt,
  "image": [imageUrl],
  "datePublished": isoDate,
  "dateModified": isoDate,
  "author": { "@type": "Organization", "name": article.data.author },
  "publisher": {
    "@type": "Organization",
    "name": "Planeta Homem",
    "logo": { "@type": "ImageObject", "url": `${siteUrl}/img/brand/logo-planeta-homem.png` },
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": articleUrl },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Início", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": article.data.category, "item": `${siteUrl}/categoria/${article.data.categorySlug}/` },
    { "@type": "ListItem", "position": 3, "name": article.data.title, "item": articleUrl },
  ],
};
---
<BaseLayout title={`${article.data.title} — Planeta Homem`} description={article.data.excerpt} image={article.data.image} jsonLd={[articleSchema, breadcrumbSchema]}>
  <div class="article-header">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Trilha de navegação">
        <a href="/">Início</a> <span>/</span>
        <a href={`/categoria/${article.data.categorySlug}/`}>{article.data.category}</a> <span>/</span>
        <span aria-current="page">{article.data.title}</span>
      </nav>
      <span class="tag">{article.data.category}</span>
      <h1>{article.data.title}</h1>
      <p class="article-meta">Publicado em {dateFormatted}</p>
    </div>
  </div>

  <div class="wrap">
    <div class="article-cover">
      <img src={article.data.image} alt={article.data.title} />
      {article.data.imageCredit && <p class="image-credit">Foto: {article.data.imageCredit}</p>}
    </div>
  </div>

  <article class="article-body">
    <Content />
  </article>

  {(prevArticle || nextArticle) && (
    <div class="wrap">
      <nav class="post-nav">
        {prevArticle ? (
          <a class="post-nav-card" href={`/${prevArticle.id}/`}>
            <img src={prevArticle.data.image} alt={prevArticle.data.title} />
            <div>
              <span class="post-nav-label">← Artigo anterior</span>
              <h3>{prevArticle.data.title}</h3>
            </div>
          </a>
        ) : <div class="post-nav-spacer" />}
        {nextArticle ? (
          <a class="post-nav-card post-nav-next" href={`/${nextArticle.id}/`}>
            <img src={nextArticle.data.image} alt={nextArticle.data.title} />
            <div>
              <span class="post-nav-label">Próximo artigo →</span>
              <h3>{nextArticle.data.title}</h3>
            </div>
          </a>
        ) : <div class="post-nav-spacer" />}
      </nav>
    </div>
  )}
</BaseLayout>
